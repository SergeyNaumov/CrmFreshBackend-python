            "types": "2",
            "autoplay": "3500",
            "animation": "rise",
            "source": "block_query",
            "where": "enabled=1 and action=1",
            "order": "id desc"
          }
        },
        {
          "type": "goods",
          "variant": "grid",
          "params": {
            "varname": "popular_goods_list",
            "dataKey": "good_popular",
