  "pages": [
    {
      "url": "/",
      "header": "Главная",
      "blocks": [
        {
          "type": "slider",
          "variant": "hero",
          "params": {
            "varname": "slider_list",
            "animation": "rise",
            "transition": "fade",
            "speed": 0.7,
            "autoplay": 5000,
            "duration": 5000,
            "height": 0,
            "start": 0,
            "loop": true,
            "source": "block_query",
            "where": "enabled=1",
            "order": "sort asc"
          }
        },
        {
          "type": "advantages",
          "params": {
            "varname": "advantages_list",
            "header": "Наши преимущества",
            "sub": "Почему покупатели выбирают наш магазин.",
            "source": "block_query",
            "where": "1=1",
            "order": "sort asc"
          }
        },
        {
          "type": "catalog",
          "variant": "grid",
          "params": {
            "varname": "catalog_list",
            "columns": 4,
            "effect": "flip",
            "enter": "rise",
            "header": "Каталог товаров",
            "sub": "Разделы каталога охватывают всю электронику — от смартфонов и ноутбуков до умного дома и аксессуаров.",
            "source": "catalog",
            "linkText": "Весь каталог",
            "linkHref": "/catalog",
            "page_head": false
          }
        },
        {
          "type": "goods",
          "variant": "grid",
          "params": {
            "varname": "new_goods_list",
            "dataKey": "good_new",
            "show": "carousel",
            "title": "Новинки",
            "sub": "Самые свежие и ожидаемые модели этого сезона.",
            "linkText": "Все новинки",
            "linkHref": "/catalog/",
            "types": "2",
            "autoplay": "3500",
            "animation": "rise",
            "source": "block_query",
            "where": "enabled=1 and new=1",
            "order": "id desc"
          }
        },
        {
          "type": "goods",
          "variant": "grid",
          "fill": "fill-2",
          "params": {
            "varname": "sale_goods_list",
            "dataKey": "good_specpredl",
            "show": "carousel",
            "title": "Спецпредложения",
